rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Format-level DOB validity — the strongest check Firestore Rules can
    // feasibly do (no generic date-arithmetic/formatting functions exist
    // here, so true age/maturity math stays a client+service-layer
    // concern via lib/utils.ts's parseDobStrict, which this mirrors the
    // shape of). Requires exactly YYYY-MM-DD — catches missing, wrong
    // type, and unparsable/malformed values. A dog whose OWN dateOfBirth
    // fails this can never be accepted as a Sire/Dam reference, even if
    // every ownership/sex check passes — "can't prove maturity" must
    // never resolve to "eligible".
    function isValidDobString(dob) {
      return dob is string && dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOwnerUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Round 20 — legacy dog transfer fix. Old dog documents predating the
    // createdByUserId/sourceType provenance fields (and, for genuinely
    // ancient records, predating currentOwnerId itself) must not error out
    // rule evaluation just because an optional field was never written.
    // `in` checks map-key presence only and never throws on a missing key
    // (unlike dot/bracket access on an absent field, which is a runtime
    // error Firestore treats as a deny) — same idiom already used by the
    // delete rule's history-field checks below.
    //
    // MUST be called with `resource.data` (the EXISTING, already-committed
    // document) — never `request.resource.data` (the caller-supplied
    // incoming write). Authorization is derived exclusively from what the
    // server already has on record, never from data the client is trying
    // to write in the same request — an update can't grant itself access
    // by asserting a currentOwnerId/tenantId that wasn't already true, and
    // a buyerEmail on the document is never treated as an identity match.
    //
    //   - currentOwnerId present (the modern, common case): that field
    //     alone decides ownership, exactly as before. No fallback — a
    //     dog that HAS moved on to a new currentOwnerId must never let
    //     its former owner back in just because tenantId still matches
    //     them (tenantId is permanent provenance, not an ownership right).
    //   - currentOwnerId absent (true legacy — predates the field
    //     existing at all): tenantId is the only ownership signal that
    //     era of the app ever recorded, so it's used as-is. Consistent
    //     with how a dog is created today (createDog() always sets
    //     tenantId == currentOwnerId == creator uid) — for a document
    //     from before that split existed, tenantId WAS the owner.
    //   - neither field present: no signal identifies anyone: deny.
    function isEffectiveDogOwner(dog) {
      return isSignedIn() && (
        ('currentOwnerId' in dog)
          ? dog.currentOwnerId == request.auth.uid
          : (('tenantId' in dog) && dog.tenantId == request.auth.uid)
      );
    }

    // Protected-field immutability via diff/affectedKeys rather than
    // per-field equality checks. request.resource.data.foo ==
    // resource.data.foo throws (denying the ENTIRE update, not just
    // failing this one check) the instant either side is missing the
    // key — exactly the bug a legacy dog missing createdByUserId/
    // sourceType hit. diff().affectedKeys() only reports keys that
    // actually differ between the two maps (added, removed, or changed
    // value) and never dereferences a missing key on either side, so it
    // is safe regardless of which optional fields exist on either the
    // old or new document. A key is "affected" if the client tries to
    // ADD it where it was absent, CHANGE its value, or REMOVE it — all
    // three are exactly what must stay denied here, including a legacy
    // dog's missing createdByUserId/sourceType being silently backfilled
    // through what looks like an ordinary client update.
    //
    // Pricing v1.2: `litterId` and `retainedByBreeder` added. Both are
    // load-bearing for api/_lib/dog-cap.js's isEligibleForCap() — a
    // client that could add/remove `litterId` on a dog it owns could
    // make a standalone dog masquerade as a cap-exempt litter puppy (or
    // vice versa), and a client that could set `retainedByBreeder`
    // directly could self-grant a cap slot with no cap check at all.
    // `litterId` is written exactly once, by api/create-litter-puppy.js;
    // `retainedByBreeder` only by api/set-dog-status.js's 'promote'/
    // 'unpromote' actions (both Admin SDK, bypass Rules entirely — this
    // only closes the DIRECT client-write path).
    //
    // Codex fix-round (Finding 3): `restrictionReason` added. It's what
    // lets api/_lib/dog-cap.js's automatic reconciliation PROVE a
    // restriction was cap-driven (restrictionReason:'plan_cap_exceeded')
    // instead of guessing from a restricted dog's shape — a client that
    // could forge that value directly could trick automatic reconciliation
    // into reactivating a dog that was actually restricted for some other
    // reason (restrictionReason:'manual', via api/set-dog-status.js's
    // 'restrict' action).
    function dogProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['tenantId', 'currentOwnerId', 'createdByUserId', 'sourceType', 'originBreederId', 'litterId', 'retainedByBreeder', 'restrictionReason']);
    }

    // Hotfix — allow a legitimate SECOND (or later) transfer. The
    // buyerEmail/buyerName/transferredAt/previousOwnerId immutability
    // clauses below exist to stop a claimed owner from silently editing
    // or erasing their dog's EXISTING transfer/claim record — but
    // api/claim-transferred-dogs.js deliberately never clears those same
    // four fields after a claim (they're kept as permanent provenance of
    // the FIRST transfer), so once any dog has been transferred once,
    // those clauses also — unintentionally — blocked the real current
    // owner from ever starting a legitimate NEW transfer, since starting
    // one requires writing new values into those exact fields. Confirmed
    // production incident: idogsbreeder@gmail.com (Honey's genuine,
    // claimed current owner) got "Something went wrong" on every attempt
    // to transfer Honey onward, purely from this rule, with zero
    // workaround.
    //
    // This function recognizes the EXACT, narrow shape
    // transferDogOwnership() (src/lib/db.ts) always writes for a
    // brand-new transfer — not just "the buyer fields changed" (which
    // would also match a hostile isolated rewrite) — so isolated edits,
    // provenance rewrites, and malformed/partial transitions still fail
    // every one of these conditions and stay denied exactly as before.
    function isLegitimateNewTransferTransition(dog) {
      return isEffectiveDogOwner(dog) &&
        // Must be starting from a non-pending state — can't begin ANOTHER
        // transfer while one is already awaiting claim (that would let
        // the currently-pending buyer/provenance fields be silently
        // overwritten before the pending buyer ever claims).
        dog.get('status', 'active') != 'transferred' &&
        dog.get('transferStatus', null) != 'pendingClaim' &&
        // Must land exactly on the post-write shape transferDogOwnership()
        // always produces.
        request.resource.data.get('status', null) == 'transferred' &&
        request.resource.data.get('transferStatus', null) == 'pendingClaim' &&
        // currentOwnerId never moves in this write — only the Admin SDK
        // claim route ever reassigns it, and only after the new buyer
        // actually claims.
        request.resource.data.get('currentOwnerId', null) == dog.get('currentOwnerId', null) &&
        // previousOwnerId must become exactly the authenticated caller's
        // own uid — the CURRENT owner recording themselves as this
        // transfer's seller, never an arbitrary/spoofed identity.
        request.resource.data.get('previousOwnerId', null) == request.auth.uid &&
        // The buyer fields this transition exists to unlock must actually
        // be present as non-empty strings in the same write — never a
        // null/removed value smuggled through under the transition's
        // cover, and never a non-string type.
        request.resource.data.get('buyerEmail', '') is string && request.resource.data.get('buyerEmail', '').size() > 0 &&
        request.resource.data.get('buyerName', '') is string && request.resource.data.get('buyerName', '').size() > 0 &&
        request.resource.data.get('transferredAt', '') is string && request.resource.data.get('transferredAt', '').size() > 0;
    }

    // Either NOTHING about the transfer shape changed (the ordinary case —
    // ANY other field being edited on a dog with or without transfer
    // history), OR this exact write is a legitimate new-transfer
    // transition (see isLegitimateNewTransferTransition above). A write
    // that changes any piece of the transfer shape WITHOUT matching the
    // full transition shape (an isolated buyerEmail edit, a spoofed
    // previousOwnerId, a status/transferStatus flip with no buyer fields,
    // etc.) matches neither branch and is denied. status/transferStatus
    // are included in the "untouched" branch's equality checks (not just
    // the four provenance fields) specifically so a write can't flip a
    // dog to status:'transferred' while leaving buyerEmail/buyerName/
    // transferredAt/previousOwnerId merely UNCHANGED (still carrying the
    // PREVIOUS transfer's values) — that combination would pass the old
    // four-field-only check (nothing about those four fields differs) yet
    // leave the document in an inconsistent "transferred but pointing at
    // the wrong/stale buyer" state; requiring status/transferStatus to
    // also stay put forces any status change through the full,
    // strictly-validated transition instead.
    function dogTransferProvenanceValid() {
      return isLegitimateNewTransferTransition(resource.data) ||
        (
          (resource.data.get('buyerEmail', null) == null ||
           request.resource.data.get('buyerEmail', null) == resource.data.get('buyerEmail', null)) &&
          (resource.data.get('buyerName', null) == null ||
           request.resource.data.get('buyerName', null) == resource.data.get('buyerName', null)) &&
          (resource.data.get('transferredAt', null) == null ||
           request.resource.data.get('transferredAt', null) == resource.data.get('transferredAt', null)) &&
          (resource.data.get('previousOwnerId', null) == null ||
           request.resource.data.get('previousOwnerId', null) == resource.data.get('previousOwnerId', null)) &&
          request.resource.data.get('status', null) == resource.data.get('status', 'active') &&
          request.resource.data.get('transferStatus', null) == resource.data.get('transferStatus', null)
        );
    }

    // A dog "belongs to" whoever is its breeder (tenantId) or its current
    // owner (currentOwnerId) — both should be able to SEE it. This is a
    // READ-only provenance grant: the original breeder keeps visibility
    // into a dog's records after transfer (their own compliance/audit
    // history), but — see dogWriteAccess below — never an ongoing
    // management right over the CURRENT owner's data.
    function dogBelongsToUser(dogId) {
      let dog = get(/databases/$(database)/documents/dogs/$(dogId)).data;
      return isSignedIn() &&
        (dog.tenantId == request.auth.uid || dog.currentOwnerId == request.auth.uid);
    }

    // Codex H8 — write access (create/update/delete of a dog's
    // vaccine/worming/health-test/activity-note/document records) requires
    // the EFFECTIVE CURRENT owner, never just historical tenantId. Before
    // this fix, dogBelongsToUser's read grant was reused for writes too,
    // so a former breeder could still update or delete the CURRENT owner's
    // records on a dog they no longer own, merely because tenantId still
    // pointed at them. tenantId is permanent provenance — legitimate for
    // read/audit (dogBelongsToUser above), never for write. Mirrors
    // isEffectiveDogOwner()'s currentOwnerId-first, tenantId-fallback
    // contract (a legacy dog that never had currentOwnerId written still
    // uses tenantId as its only ownership signal — same as everywhere
    // else in this file that gates a WRITE).
    function dogWriteAccess(dogId) {
      let dog = get(/databases/$(database)/documents/dogs/$(dogId)).data;
      return isSignedIn() && (
        ('currentOwnerId' in dog)
          ? dog.currentOwnerId == request.auth.uid
          : (('tenantId' in dog) && dog.tenantId == request.auth.uid)
      );
    }

    // iDogs Pricing v1.1 §3.3: a 'restricted' dog's Withheld column is "No
    // new health records or documents" — narrower than the blanket "no
    // editing" applied to the dog document itself (see dogs/{dogId}
    // update above). Used only for CREATE on the dogId-keyed subcollections
    // below; existing records remain readable, and this deliberately does
    // NOT also gate update/delete of a record created before the dog
    // became restricted — the pricing record only calls out new records.
    // Requires dogWriteAccess (Codex H8), not dogBelongsToUser — a former
    // breeder must not be able to add NEW records to the current owner's
    // dog any more than they can edit/delete existing ones.
    function dogAllowsNewRecords(dogId) {
      let dog = get(/databases/$(database)/documents/dogs/$(dogId)).data;
      return dogWriteAccess(dogId) && dog.get('status', 'active') != 'restricted';
    }

    // NOTE: full Sire/Dam breeding-parent eligibility (sex, ownership,
    // deceased, DOB validity, AND actual minimum-age maturity — which
    // needs real date arithmetic this rules language has no functions
    // for) is no longer checked here. isEligibleBreedingDog/
    // isEligibleSire/isEligibleDam/heatCycleSireValid were removed —
    // litters create and heatCycles create/update are now `if false`
    // below and happen exclusively through api/create-litter.js and
    // api/save-heat-cycle.js (Admin SDK, full validation via
    // _lib/parent-eligibility.js). See those files for the canonical
    // policy (Codex round 3, Blocker 1).

    // Billing state is owned exclusively by trusted Admin SDK services.
    // iDogs Pricing v1.1 (Pricing_Decision_Record_v1.1.md, LOCKED) adds
    // pastDueSince/billingInterval/scanPeriodAnchorDay/plusScansUsed/
    // plusScansPeriodStart/freeScansUsed — all written only by
    // api/stripe-webhook.js, api/enforce-billing-grace.js, or api/scan.js,
    // never by the browser (a client that could set freeScansUsed to 0 or
    // plusScansUsed downward would defeat the entire AI-scan quota).
    function userBillingFields() {
      return [
        'plan',
        'subscriptionStatus',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'trialEndsAt',
        'planActivatedAt',
        'pastDueSince',
        'billingInterval',
        'scanPeriodAnchorDay',
        'plusScansUsed',
        'plusScansPeriodStart',
        'freeScansUsed',
        // Codex H5 — out-of-order Stripe event ownership tracking. A
        // client that could set/clear these could trick the webhook's
        // staleness guard into accepting a stale or forged event as
        // current, or into rejecting a legitimate one.
        'lastKnownSubscriptionId',
        'subscriptionEventTimestamps',
        // Codex H1 (round 4) — quota-initialization ownership marker. A
        // client that could set this to an arbitrary value could trick
        // the webhook handler into treating its NEXT legitimate event as
        // a "genuine new activation" and re-zeroing plusScansUsed on
        // demand — this field must be exactly as protected as
        // plusScansUsed itself.
        'plusScansSubscriptionId',
        // iDogs SMS Add-on V1 — paid entitlement, Stripe identity and quota
        // counters are trusted server state. Client writes to any of these
        // could self-grant SMS or restore consumed credits.
        'smsAddonStatus',
        'smsStripeSubscriptionId',
        'smsStripePriceId',
        'smsPeriodStart',
        'smsPeriodEnd',
        'smsCreditsLimit',
        'smsCreditsUsed',
        'smsLastBillingEventAt',
        'smsLastKnownSubscriptionId',
        'smsSubscriptionEventTimestamps',
        // Internal Super Admin entitlement (api/_lib/entitlements.js
        // computeEffectivePlan()) — an admin-granted Plus override,
        // completely independent of Stripe. A client that could set this
        // directly could self-grant full Plus access with no payment and
        // no admin action at all; only a trusted Admin SDK path
        // (scripts/grant-internal-entitlement.mjs) may ever write it.
        'internalEntitlement'
      ];
    }

    // ── users/{uid} — owners manage non-billing profile fields only ──
    match /users/{userId} {
      allow read: if isOwnerUser(userId);
      allow create: if isOwnerUser(userId) &&
        !request.resource.data.keys().hasAny(userBillingFields());
      allow update: if isOwnerUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(userBillingFields());
      // Deleting a document that contains protected fields would also delete
      // trusted billing state. Unbilled profiles retain the existing client
      // account-deletion path; billed profiles require a future trusted
      // cancellation/account-deletion service.
      allow delete: if isOwnerUser(userId) &&
        !resource.data.keys().hasAny(userBillingFields());
    }

    // ── dogs/{dogId} ──
    // NOTE: if there is a public QR "passport" view of a dog (scan a QR code
    // to see public-safe details without logging in), this rule will BREAK
    // it, because read now requires being the tenant or current owner.
    // Public passport viewing needs to go through a server API route (using
    // Admin SDK, which bypasses these rules) that returns only the fields
    // allowed by PassportVisibility — never a direct client-side Firestore
    // read of the full dog document. Flag this before deploying if such a
    // page exists.
    match /dogs/{dogId} {
      // resource == null guard: createLitterPuppyAtomic() does a tx.get()
      // on a not-yet-created dogId (its idempotency check — "does this
      // dog already exist from a prior retry?") before ever writing it.
      // Without this guard, dereferencing resource.data on a get() of a
      // missing document is a rules runtime error, which Firestore
      // treats as a deny — breaking puppy creation outright, not just
      // relaxing a check. A missing document exposes no data either way.
      // Same pattern already used below for reminders/{id}'s get.
      allow read: if isSignedIn() &&
        (resource == null || resource.data.tenantId == request.auth.uid || resource.data.currentOwnerId == request.auth.uid);

      // Only the effective owner may write (see isEffectiveDogOwner above —
      // currentOwnerId when present, tenantId fallback only for legacy
      // dogs that never had currentOwnerId written at all) — not the
      // former breeder once a claim has moved currentOwnerId elsewhere
      // (tenantId is permanent provenance for *read*, not an ongoing
      // management right). Verified safe: transferDogOwnership() is only
      // ever called while the caller still IS the effective owner
      // (currentOwnerId only changes via the server-side claim route), so
      // no legitimate flow needs tenantId access on top of an existing
      // currentOwnerId. dogProtectedFieldsUnchanged() (above) keeps
      // tenantId/currentOwnerId/createdByUserId/sourceType immutable via
      // any client write — including adding a legacy dog's missing
      // createdByUserId/sourceType through what looks like an ordinary
      // update — changed only by the Admin SDK claim route, which
      // bypasses these rules entirely.
      // Ownership-history fields are protected — a dog's transfer/claim
      // record is provenance, never something the current owner (who,
      // post-claim, is the buyer — the very person the history is about)
      // should be able to silently edit or erase. buyerEmail/buyerName/
      // transferredAt/previousOwnerId may ONLY change together as part of
      // a legitimate NEW transfer (dogTransferProvenanceValid() above) —
      // any isolated edit of one of them, or a change that doesn't match
      // that exact transition shape, stays denied. claimedAt/claimedBy
      // have no legitimate second-write path at all (only the Admin SDK
      // claim route ever sets them, once) and remain flatly immutable
      // once set, same as before. buyerPhone is deliberately left out of
      // both: a contact-detail typo fix isn't a history-tampering risk
      // the way erasing buyerEmail/transferredAt/previousOwnerId/
      // claimedAt/claimedBy would be.
      // iDogs Pricing v1.1 (Pricing_Decision_Record_v1.1.md §3.3, LOCKED):
      // a 'restricted' dog is read-only — no field edits — with exactly
      // one exception: a legitimate NEW transfer transition must still be
      // allowed even while restricted ("Transfer still allowed —
      // preserves chain of custody"; a restricted dog is never blocked
      // from being sold on). status/archived<->active swaps go through
      // api/set-dog-status.js (Admin SDK, bypasses these Rules entirely,
      // with its own cap-aware check) — this clause only needs to stop an
      // ORDINARY client edit (name/breed/notes/etc) from landing on a
      // restricted dog.
      allow update: if isEffectiveDogOwner(resource.data) &&
        dogProtectedFieldsUnchanged() &&
        dogTransferProvenanceValid() &&
        (resource.data.get('status', 'active') != 'restricted' || isLegitimateNewTransferTransition(resource.data)) &&
        (resource.data.get('claimedAt', null) == null ||
         request.resource.data.get('claimedAt', null) == resource.data.get('claimedAt', null)) &&
        (resource.data.get('claimedBy', null) == null ||
         request.resource.data.get('claimedBy', null) == resource.data.get('claimedBy', null));

      // Codex round 4, Blocker 5: direct client deletion is now denied
      // for ANY dog carrying ownership history — not just a dog
      // currently mid-transfer. Round 3 only checked the CURRENT
      // transfer/claim status (deliberately allowing a buyer who had
      // already fully claimed a dog to delete their own, now-clean-
      // looking record). Codex flagged that as insufficient: a dog with
      // buyerEmail/previousOwnerId/transferredAt/claimedAt/claimedBy set
      // carries permanent provenance regardless of its CURRENT status —
      // that history is exactly what a compliance/dispute inquiry would
      // need later, and the round-3 carve-out let it be destroyed by
      // whoever currently held the dog. Any one of the five history
      // fields being present at all — even alone, even if the rest look
      // "clean" (claimedBy set without claimedAt, a partial/legacy
      // write, etc.) — now blocks deletion outright; there is no
      // client-side path to delete a history-bearing dog at all. A dog
      // with zero history fields (the common case — never transferred)
      // is unaffected and deletes exactly as before, still gated on the
      // current transfer/claim status too as defense in depth.
      //
      // Codex round 6, Blocker 3: switched from `.get(field, null) ==
      // null` to `!('field' in resource.data)` — the former treats an
      // EXPLICITLY stored null the same as a field that was never
      // written at all, which is the wrong alignment: a genuinely clean
      // Dog never has these fields written in the first place, so a
      // document carrying an explicit null is itself an anomalous/
      // malformed record, not a clean one, and must fail closed the same
      // as any other present-but-empty value. `in` checks map-key
      // presence only, independent of the stored value — the exact same
      // semantics as api/_lib/litter-eligibility.js's isDogHistoryBearing,
      // which this rule is deliberately kept aligned with by hand.
      allow delete: if isSignedIn() && resource.data.currentOwnerId == request.auth.uid &&
        resource.data.get('status', 'active') != 'transferred' &&
        resource.data.get('transferStatus', null) != 'pendingClaim' &&
        !('buyerEmail' in resource.data) &&
        !('previousOwnerId' in resource.data) &&
        !('transferredAt' in resource.data) &&
        !('claimedAt' in resource.data) &&
        !('claimedBy' in resource.data);

      // Codex H2 — direct client create is now denied outright. Rules
      // cannot count how many dogs this uid already has 'active'
      // (Firestore Rules has no cross-document aggregate-count
      // primitive), so the ownership/DOB-format checks this rule used to
      // run were never enough to enforce the Free=2/Plus=5 cap — a
      // client (a modified build, or a direct Firestore SDK call from
      // devtools, bypassing the app UI's own best-effort
      // reconcileDogCapBestEffort() follow-up entirely) could create
      // unlimited 'active' dogs. Mirrors the exact pattern already used
      // for litters/heat-cycles/puppies: the risky write moves to a
      // trusted Admin SDK endpoint (api/create-dog.js) that computes the
      // cap-aware status from a live count taken inside the SAME
      // transaction as the write. Never blocks creation — an over-cap
      // dog simply lands 'restricted' instead of 'active'.
      allow create: if false;
    }

    // ── passportReservations/{passportId} — uniqueness index for
    // Dog.passportId (ADR-002 Phase C1). Document ID IS the passportId
    // being claimed; existence alone is the uniqueness signal, so no
    // client ever needs to read another user's reservation for the
    // create flow to work correctly (the transaction in
    // reservePassportId() checks existence via a read permitted here).
    // Permanent once created — never updated or deleted, since a
    // passportId must never be reassigned or freed for reuse.
    match /passportReservations/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Records keyed by dogId — access follows the parent dog's ownership ──
    // Codex H8: read stays dogBelongsToUser (tenantId OR currentOwnerId —
    // the former breeder keeps provenance visibility after a transfer);
    // update/delete now require dogWriteAccess (currentOwnerId only, with
    // legacy tenantId fallback) — a former breeder can no longer edit or
    // delete the current owner's records just because tenantId still
    // points at them.
    //
    // `resource == null ||` on every read rule below: found while writing
    // this round's Rules tests — a get() on a document that has just been
    // deleted (e.g. a caller confirming its own delete succeeded) has
    // resource == null, and dereferencing resource.data on that throws
    // rather than denying, which Firestore Rules treats as an error, not
    // a clean deny. Same guard already used elsewhere in this file (see
    // dogs/{dogId}'s read rule and reminders/{id}'s allow get) — a missing
    // document exposes no data either way, so denying it outright is both
    // safe and correct, and now consistent across every collection here.
    match /vaccineRecords/{id} {
      allow read: if resource == null || dogBelongsToUser(resource.data.dogId);
      allow update, delete: if dogWriteAccess(resource.data.dogId);
      allow create: if dogAllowsNewRecords(request.resource.data.dogId);
    }
    match /wormingRecords/{id} {
      allow read: if resource == null || dogBelongsToUser(resource.data.dogId);
      allow update, delete: if dogWriteAccess(resource.data.dogId);
      allow create: if dogAllowsNewRecords(request.resource.data.dogId);
    }
    match /healthTests/{id} {
      allow read: if resource == null || dogBelongsToUser(resource.data.dogId);
      allow update, delete: if dogWriteAccess(resource.data.dogId);
      allow create: if dogAllowsNewRecords(request.resource.data.dogId);
    }
    match /activityNotes/{id} {
      allow read: if resource == null || dogBelongsToUser(resource.data.dogId);
      allow update, delete: if dogWriteAccess(resource.data.dogId);
      allow create: if dogAllowsNewRecords(request.resource.data.dogId);
    }

    // ── heatCycles — read/delete use the same dogBelongsToUser access
    // pattern as the other dogId-keyed records above (no age check
    // needed for either, so they stay client-side). create/update both
    // require verifying the Dam and/or Sire "meets actual minimum
    // breeding maturity", which needs real date arithmetic Firestore
    // Rules has no functions for — both now happen exclusively through
    // api/save-heat-cycle.js (Admin SDK, full validation via
    // _lib/parent-eligibility.js). Direct client create/update is
    // denied outright (Codex round 3, Blocker 1).
    match /heatCycles/{id} {
      allow read: if resource == null || dogBelongsToUser(resource.data.dogId);
      // Codex H8: delete now requires dogWriteAccess (current owner only),
      // same rationale as the dogId-keyed collections above.
      allow delete: if dogWriteAccess(resource.data.dogId);
      allow create, update: if false;
    }

    // ── documents — access follows the parent dog's ownership, same as
    // vaccineRecords/healthTests/activityNotes, so a claimed dog's
    // pre-transfer documents stay visible to its new current owner. (A
    // plain tenantId-literal rule here previously also broke
    // getDogDocuments()'s dogId-only list query outright — Firestore
    // denies a `list` query up front when its only where-clause doesn't
    // match a literal field the rule compares against; a get()-based rule
    // like dogBelongsToUser doesn't have that restriction.) ──
    match /documents/{id} {
      allow read: if resource == null || dogBelongsToUser(resource.data.dogId);
      allow update, delete: if dogWriteAccess(resource.data.dogId);
      allow create: if dogAllowsNewRecords(request.resource.data.dogId);
    }
    // NOTE: get and list are split (rather than a combined `read`) so that
    // an existence-check on a not-yet-created reminder (e.g.
    // upsertVaccineReminder()'s dedupe check before its first-ever write)
    // doesn't get denied — `resource == null` for a get on a missing doc,
    // and dereferencing resource.data on null previously errored out the
    // whole rule, which Firestore treats as a deny. A missing document
    // still exposes no data either way.
    //
    // Production bug fix: `reminders` was the one dogId-keyed collection
    // that never got the same dogBelongsToUser() read grant as its
    // siblings (vaccineRecords/wormingRecords/healthTests/documents/
    // activityNotes/heatCycles below all use it). src/lib/db.ts's
    // getReminders()/getAllRemindersForUser()/getAllPendingReminders()
    // each run a "claimed dog" query keyed only on dogId (no tenantId
    // filter) to surface reminders on a dog the caller currently owns via
    // transfer/claim, whose reminder docs still carry the ORIGINAL
    // breeder's tenantId — dogs.tenantId is permanent provenance by
    // design (see api/send-reminders.js's getReminderEligibleDogs()
    // comment) and is never reassigned, so this was a GUARANTEED,
    // permanent permission-denied for every account holding a claimed
    // dog, not a transient gap — the tenantId-only rule below could never
    // statically satisfy a query with no tenantId filter. Adding
    // dogBelongsToUser(resource.data.dogId) as a second, OR'd grant on
    // get/list only (never create/update/delete — those stay strictly
    // tenantId-scoped, matching every write path today) closes this using
    // the exact same trust boundary already applied to every sibling
    // collection: a dog's current owner may READ its records, exactly as
    // they already can for vaccines/health/worming/documents/notes. The
    // cheap tenantId check stays first so the common case (breeder or
    // already-reassigned reminder) never pays the extra get() cost.
    match /reminders/{id} {
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.tenantId == request.auth.uid
            || dogBelongsToUser(resource.data.dogId));

      allow list: if isSignedIn()
        && (resource.data.tenantId == request.auth.uid
            || dogBelongsToUser(resource.data.dogId));

      allow create: if isSignedIn()
        && request.resource.data.tenantId == request.auth.uid;

      allow update, delete: if isSignedIn()
        && resource.data.tenantId == request.auth.uid;
    }
    // Codex round 4, Blocker 3: direct client update/delete are now
    // BOTH denied outright, not just create. Round 3 left update/delete
    // client-reachable (update guarded by damId/sireId/tenantId
    // immutability + DOB-format-while-puppies-exist; delete guarded by
    // tenantId ownership only) on the theory that the app's own
    // client-side transaction logic (LittersPage.tsx) was the only thing
    // that would ever exercise them. Codex flagged the gap: a rule that
    // permits a write at all permits ANY write matching its shape,
    // regardless of which code path sends it — a plain deleteDoc() or
    // updateDoc() call (browser devtools, a bug, any other direct write)
    // was equally valid under the old rule, bypassing the app's own
    // puppy-handling/DOB-propagation logic entirely and orphaning
    // puppies or directly mutating puppyIds with no membership check at
    // all. There is no way to fully re-express "puppies were handled
    // correctly" as a Rules predicate (no loops, and cross-document
    // get() calls for every puppyIds entry inside a rule is impractical
    // at scale) — so, per the explicit instruction to route unsafely-
    // Rules-checkable mutations to a trusted server endpoint, ALL litter
    // writes after create now happen exclusively through
    // api/update-litter.js, api/delete-litter.js, and
    // api/remove-litter-puppy.js (Admin SDK, bypasses Rules — each
    // endpoint owns its own safety end to end). Read stays client-side
    // (getLitters() still needs it; reading a litter document leaks
    // nothing a rule can't already scope to its own tenant).
    match /litters/{id} {
      allow read: if isSignedIn() && resource.data.tenantId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ── litterShowcases/{litterId} — iDogs Litter Showcase MVP (Slice 1).
    // Document id == litterId (one Showcase per litter, enforced
    // structurally by api/create-showcase.js refusing to overwrite an
    // existing doc). Same posture as litters above and for the same
    // reason: "does litterId belong to this caller", "is puppyId a
    // current member of this litter", and "one Showcase per litter" all
    // need cross-document reads/validation Firestore Rules cannot safely
    // express (no loops over a dynamic puppies map, no way to compare
    // against another document's array from inside a single rule
    // predicate at scale) — so every write goes exclusively through the
    // trusted Admin SDK endpoints: api/create-showcase.js,
    // api/set-showcase-enabled.js, api/update-showcase-puppy.js,
    // api/bulk-update-showcase-puppies.js. Read stays client-side (the
    // breeder's own Litters page reads its own Showcase directly) —
    // scoped to the owning tenant only, same as litters' own read rule.
    // Deliberately does NOT allow anonymous/public read — Slice 1 has no
    // public Showcase page yet (SECURITY: "Do not allow anonymous access
    // yet"); a future public page must go through its own trusted Admin
    // SDK endpoint returning an allowlisted projection, never a direct
    // client read of this document (which is breeder-only and, being
    // keyed purely by puppyId → {visible, availability}, carries no
    // buyer/microchip/vet/ownership data anyway — but the access
    // boundary is enforced here regardless, not by what happens to be in
    // the document today).
    //
    // Staging QA fix — `resource == null ||`: every litter starts with NO
    // Showcase document at all (create-showcase.js is the only write
    // path, and it's an explicit opt-in action). lib/db.ts's
    // getShowcaseForLitter() does a plain getDoc() to find out whether
    // one exists yet, and already correctly treats `!snap.exists()` as
    // "no Showcase yet" (returns null, not an error) — but the ORIGINAL
    // version of this rule dereferenced `resource.data.tenantId`
    // unconditionally, even when `resource` is null (no document). A
    // Rules-evaluation error on a missing document is NOT the same as a
    // clean "not found" — Firestore surfaces it to the client as
    // `permission-denied` ("Missing or insufficient permissions."),
    // before the SDK ever gets a chance to report "doesn't exist". Every
    // breeder opening ANY litter's Showcase panel for the first time hit
    // this. Exactly the same class of bug already fixed (and explicitly
    // documented) for dogs/{dogId}, vaccineRecords, wormingRecords,
    // healthTests, activityNotes, heatCycles, documents, and reminders
    // above — this collection was simply missed when it was first
    // written. `resource == null` costs nothing to allow: a missing
    // document exposes no data either way, same reasoning as every one
    // of those siblings.
    match /litterShowcases/{litterId} {
      allow read: if isSignedIn() && (resource == null || resource.data.tenantId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ── showcaseEnquiries — Litter Showcase MVP Slice 2 ("Customer
    // enquiries"). A potential buyer submits one from the PUBLIC
    // Showcase page (no account at all), so creation can never require
    // isSignedIn() — but exactly like litterPuppyOperations below and
    // litterShowcases above, the actual write moves to a trusted Admin
    // SDK endpoint (api/create-showcase-enquiry.js) rather than being
    // allowed directly here, because the write needs validation
    // firestore.rules cannot safely express on its own: resolving the
    // caller-supplied share TOKEN to a tenantId/litterId (a
    // cross-document hash lookup), confirming the Showcase is actually
    // live (not disabled/expired/revoked), confirming an optional
    // puppyId is really a currently-visible member of that Showcase, and
    // rate-limiting/spam-filtering the request — none of which a Rules
    // predicate can do. So, same posture as every other
    // Admin-SDK-owned collection in this file: allow read only for the
    // OWNING breeder (an enquiry is theirs to see once it exists), deny
    // every direct client write outright.
    //
    // Deliberately NO `resource == null ||` guard here (unlike
    // litterShowcases above) — that guard exists specifically for a
    // single-document `getDoc()` lookup by a KNOWN id, where "the
    // document doesn't exist yet" is a real, expected outcome
    // (getShowcaseForLitter checks "does this litter even have a
    // Showcase yet"). Enquiries are never looked up by id — the client
    // only ever lists them via a `where('litterId', '==', ...)` query
    // (getEnquiriesForLitter), the same query-only access pattern the
    // `litters` collection's own (also guard-free) rule above uses. A
    // `resource == null` comparison is meaningless for a `list`
    // operation (there is no single candidate resource to be null) and
    // was confirmed, while writing this Slice's own test suite, to
    // throw a Rules evaluation error ("Property tenantId is undefined
    // on object") for a `list` query rather than a clean allow/deny —
    // simply omitting it, matching `litters`' own precedent, is the
    // correct fix, not a narrower version of the guard.
    match /showcaseEnquiries/{enquiryId} {
      allow read: if isSignedIn() && resource.data.tenantId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Pre-transfer buyer access grants are deliberately server-only. They
    // contain the buyer email used as an authorization factor and must never
    // be enumerable or mutable from the browser. Both breeder management and
    // buyer reads go through authenticated Admin SDK endpoints which return
    // only allowlisted projections.
    match /dogPrivateAccess/{dogId} {
      allow read, write: if false;
    }

    // ── litterPuppyOperations — internal idempotency ledger for
    // api/create-litter-puppy.js (Codex round 4, Blocker 4). Written
    // exclusively by that endpoint (Admin SDK) atomically with the Dog
    // document it creates, so a retry can be verified against a
    // persisted record instead of trusting a bare "does this dogId
    // exist" check. Never read or written by any client directly — a
    // client's only interaction with this system is via the API's JSON
    // response, so there is no legitimate client access pattern here at
    // all, and no client action should ever be able to forge, inspect,
    // or tamper with an operation record.
    match /litterPuppyOperations/{id} {
      allow read, write: if false;
    }

    // ── smsDeliveries — SMS quota/idempotency ledger. Written only by
    // trusted Admin SDK reminder services. No browser access is required;
    // user-facing usage is exposed by authenticated billing-summary APIs.
    match /smsDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // ── processedSmsStripeEvents — isolated SMS add-on webhook ledger.
    // Same Admin-SDK-only trust boundary as the base subscription ledger.
    match /processedSmsStripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ── processedStripeEvents — webhook idempotency ledger
    // (api/_lib/webhook-handler.js). Written exclusively by the Admin SDK
    // to detect a redelivered/replayed Stripe event before applying its
    // entitlement effects twice. No legitimate client access pattern.
    match /processedStripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ── litterQuotaLedger — immutable record of every litter that has
    // ever counted against the rolling-365-day quota (iDogs Pricing v1.1
    // §3.4, LOCKED). Written exclusively by api/create-litter.js /
    // api/update-litter.js (Admin SDK) when a litter's whelping date
    // (actualBirthDate) is first set, and deliberately NEVER deleted —
    // this is what makes "delete/archive must not restore quota" actually
    // hold even when a litter document itself is later hard-deleted (see
    // api/delete-litter.js). No legitimate client access pattern.
    match /litterQuotaLedger/{id} {
      allow read, write: if false;
    }

    // ── auditLogs — append-only, never editable/deletable by clients ──
    match /auditLogs/{id} {
      allow read: if isSignedIn() && resource.data.tenantId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── scanLogs — written whenever ANYONE scans a public QR passport, so
    // create must stay open to unauthenticated requests. But scan logs
    // should never be readable, editable, or deletable by clients (only via
    // Admin SDK / a server route, if you ever need to show scan history to
    // the breeder) — otherwise this becomes a stalking/tracking leak.
    match /scanLogs/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── rateLimitCounters — durable, atomic rate-limit state for public
    // Showcase endpoints (Codex fix-round: "Rate limiting" — see
    // api/_lib/durable-rate-limit.js). Written exclusively by the Admin
    // SDK inside a Firestore transaction; no legitimate client access
    // pattern at all (a client that could read/write its own counter
    // could trivially defeat the limiter it's meant to be bound by).
    // REQUIRED before production: a Firestore TTL policy on this
    // collection's `expiresAt` field — see durable-rate-limit.js's own
    // header comment for the exact gcloud command; not yet configured.
    match /rateLimitCounters/{id} {
      allow read, write: if false;
    }

    // ── landingMediaPublished/{slotId} — self-managed Landing Page
    // Media (Super Admin -> Landing Page Media). A fixed, small set of
    // four slot documents (hero/dog-profile/puppy-showcase/digital-
    // passport) that drive the public marketing landing page — no user,
    // breeder, or dog data. Public-readable so the landing page can pick
    // up newly-published media on a normal page load with no code change
    // or redeploy. Write-denied to every client outright — the ONLY way
    // this collection is ever written is the trusted Admin SDK endpoint
    // api/manage-landing-media.js (Super Admin allowlist, verified
    // Firebase ID token), same posture as every other Admin-SDK-owned
    // collection in this file.
    //
    // The DRAFT side of this feature (landingMediaDrafts/{slotId}) is
    // deliberately given NO explicit rule at all — it falls through to
    // the default-deny match below, exactly like dogPrivateAccess and
    // litterPuppyOperations above. A draft's private Storage object must
    // never be discoverable by a public reader before an admin has
    // chosen to Publish it; the admin's own preview goes through the
    // authenticated api/get-landing-media-state.js endpoint, never a
    // direct client Firestore read.
    match /landingMediaPublished/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Deny everything else by default ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
